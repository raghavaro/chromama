{
  "manifest_version": 3,
  "name": "chromama",
  "version": "0.1.0",
  "description": "Reclaim RAM and attention from a thousand open tabs. Discard, archive, restore, reorganize.",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "system.memory"
  ],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open chromama"
  }
}
